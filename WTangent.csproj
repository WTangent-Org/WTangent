<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup Condition="'$(WTangentLocal)' != 'true'">
    <PackageReference Include="System.CommandLine" Version="2.0.10"/>
    <!-- 运行时契约（Application/ITool 等）：宿主实现并注入组件 -->
    <PackageReference Include="WTangent.Components" Version="0.0.11" PrivateAssets="all"/>
  </ItemGroup>

  <!-- 本地开发开关（-p:WTangentLocal=true，配工作区根 dev-install.ps1）：直接引用 Core 源码 + 生成器项目，
       绕过 nuget 等索引传播。空壳是宿主：Core 必须拷进输出（不设 Private=false），组件运行时统一用这份 -->
  <ItemGroup Condition="'$(WTangentLocal)' == 'true'">
    <PackageReference Include="System.CommandLine" Version="2.0.10"/>
    <ProjectReference Include="..\WTangent.Components\src\WTangent.Core\WTangent.Core.csproj"/>
    <ProjectReference Include="..\WTangent.Components\src\WTangent.Components\Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" Private="false"/>
    <!-- ProjectReference 不经包的 buildTransitive props，生成器需要的属性这里手动声明（与包内 props 一致） -->
    <CompilerVisibleProperty Include="ProjectDir"/>
    <CompilerVisibleProperty Include="AssemblyName"/>
  </ItemGroup>

  <!-- 空壳对组件只有运行时关系（Assembly.LoadFrom + IEntry 反射），不引用组件源码；
       deps/ 目录即使存在也不参与编译 -->
  <ItemGroup>
    <Compile Remove="deps/**"/>
    <None Remove="deps/**"/>
    <Content Remove="deps/**"/>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>wtangent</AssemblyName>
    <Version>0.8.1</Version>
    <!-- 引用组件项目（同为 Exe）时指定空壳自己的入口 -->
    <StartupObject>WTangent.Program</StartupObject>
  </PropertyGroup>

</Project>
